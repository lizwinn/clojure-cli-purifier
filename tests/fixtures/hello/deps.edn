{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.3"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        hiccup/hiccup {:mvn/version "2.0.0-RC5"}
        local/greet {:local/root "lib/greet"}}
 :aliases
 {;; A git dependency given by tag and short commit, as most projects take
  ;; their test runner.
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; A SNAPSHOT dependency from Clojars, from 2012.
  :snapshot {:extra-paths ["checks"]
             :extra-deps {hiccup/hiccup {:mvn/version "1.0.0-SNAPSHOT"}}
             :main-opts ["-m" "hello.snapshot"]}
  ;; A version range, which Maven Resolver resolves from the version list
  ;; of the repository.
  :range {:extra-paths ["checks"]
          :extra-deps {org.clojure/core.memoize {:mvn/version "[1.0.257,1.1.266]"}}
          :main-opts ["-m" "hello.range"]}
  ;; tools.build from git, as its documentation recommends.
  :build {:deps {io.github.clojure/tools.build {:git/tag "v0.10.10" :git/sha "deedd62"}}
          :ns-default build}}}
